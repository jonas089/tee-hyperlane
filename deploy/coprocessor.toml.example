# The ark deployment: five origins, eight routes, one shared CVM running an enclave per origin.
#
# Chains are declared once and routes name them. A chain's fields are documented on its
# `Config` in tee-hyperlane/crates/tee-coprocessor/src/origin/{l1,l2}/<chain>.rs. This is the
# live file with the one metered key replaced; refresh it after a re-deployment:
#
#   ssh chef@ark 'cat ~/tee-ism-nonzk/devnet/.state/coprocessor.toml' \
#     | sed 's|/v2/[A-Za-z0-9_-]*|/v2/ALCHEMY_KEY|' > deploy/coprocessor.toml.example

tick_secs = 2
proof_dir = "/home/chef/tee-ism-nonzk/devnet/.state/proofs"
api_listen = "0.0.0.0:3001"

[faucet]
chain = "celestia"
key = "user"
grants = [
  { symbol = "TIA", denom = "utia", amount = 100000000000 },
  { symbol = "teeUSD", denom = "hyperlane/0x726f757465725f61707000000000000000000000000000020000000000000002", amount = 200000000000 },
]

# ---------------------------------------------------------------- chains

# The local Celestia devnet: origin of four routes, destination of four.
[chains.celestia]
kind = "celestia"
domain = 1297040299
rpc = "http://localhost:26657"
mailbox = "0x68797065726c616e650000000000000000000000000000000000000000000000"
merkle_tree_hook = "0x726f757465725f706f73745f6469737061746368000000030000000000000000"
lag = 1
chain_id = "teeism-local"
home = "/home/chef/tee-ism-nonzk/devnet/.state/celestia"

# Mocha, read only as the chain Eden posts its headers to.
[chains.mocha]
kind = "celestia"
domain = 1297040200
rpc = "https://rpc.celestia-mocha.com"

[chains.sepolia]
kind = "ethereum"
domain = 11155111
rpc = "https://rpc.sepolia.ethpandaops.io"
beacon_rpc = "https://ethereum-sepolia-beacon-api.publicnode.com"
mailbox = "0xfFAEF09B3cd11D9b20d1a19bECca54EEC2884766"
merkle_tree_hook = "0x4917a9746A7B6E0A57159cCb7F5a6744247f2d0d"

# Arbitrum and Base are attested from blocks their sequencer signed: Arbitrum's from its feed,
# Base's from the OP Stack p2p network. `rpc` is the one metered endpoint for each (Alchemy,
# key ALCHEMY_KEY in devnet/.env; never commit it): it is read only at the ISM's trusted height,
# which can be old. Logs and reads near the head go to the free endpoint.
[chains.arbitrum]
kind = "arbitrum"
domain = 421614
rpc = "https://arb-sepolia.g.alchemy.com/v2/ALCHEMY_KEY"
feed = "wss://sepolia-rollup.arbitrum.io/feed"
logs_rpc = "https://sepolia-rollup.arbitrum.io/rpc"
send_rpc = "https://sepolia-rollup.arbitrum.io/rpc"
mailbox = "0x598facE78a4302f11E3de0bee1894Da0b2Cb71F8"
merkle_tree_hook = "0xAD34A66Bf6dB18E858F6B686557075568c6E031C"

[chains.base]
kind = "base"
domain = 84532
rpc = "https://base-sepolia.g.alchemy.com/v2/ALCHEMY_KEY"
p2p_port = 9222
logs_rpc = "https://sepolia.base.org"
send_rpc = "https://sepolia.base.org"
mailbox = "0x6966b0E55883d49BFB24539356a2f8A673E02039"
merkle_tree_hook = "0x86fb9F1c124fB20ff130C41a79a432F770f67AFD"

[chains.eden]
kind = "eden"
domain = 3735928814
celestia = "mocha"
da_rpc = "http://localhost:26658"
rpc = "https://ev-reth-eden-testnet.binarybuilders.services:8545/"
logs_rpc = "https://rpc.testnet.eden.gateway.fm/"
send_rpc = "https://rpc.testnet.eden.gateway.fm/"
mailbox = "0x1D32350f3440BEa7f7E450Aa085f63E0d7E38729"
merkle_tree_hook = "0xCfBE7016D123d52A7Db4fc7D087cCb5421dbF8db"

# ---------------------------------------------------------------- trade

# The pools /api/v1/trade swaps through, and the assets it routes.
[trade]
default_venue = "base"
hub_rest = "http://localhost:1317"
hub_mailbox = "0x68797065726c616e650000000000000000000000000000000000000000000000"
noop_ism = "0x726f757465725f69736d00000000000000000000000000000000000000000000"
routing_ism = "0x726f757465725f69736d00000000000000000000000000010000000000000035"

[trade.venues.sepolia]
