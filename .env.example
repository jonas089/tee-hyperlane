# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Funds the Sepolia / Arbitrum Sepolia / Base Sepolia deployments and relaying.
SEPOLIA_PRIVATE_KEY=0x...

# Funds the Celestia mocha-5 deployment and relaying. Hex, no 0x.
CELESTIA_MOCHA_PRIVATE_KEY=...

# Phala Cloud, for deploying and updating the enclaves.
PHALA_CLOUD_API_KEY=...

# Endpoints. All untrusted: the enclave re-verifies everything they return.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_BEACON=https://ethereum-sepolia-beacon-api.publicnode.com
ARBITRUM_SEPOLIA_RPC=https://arbitrum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC=https://base-sepolia-rpc.publicnode.com
CELESTIA_RPC=https://rpc-mocha.pops.one

# The enclaves.
TEE_NODE_ETHEREUM=https://<app-id>-8080.dstack-pha-prod9.phala.network
TEE_NODE_CELESTIA=https://<app-id>-8080.dstack-pha-prod9.phala.network

# Proving is always local CPU.
SP1_PROVER=cpu
